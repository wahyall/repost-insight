# Database PostgreSQL + pgvector
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/repostinsight"

# Apify Actor
APIFY_ACTOR_ID="data-slayer~instagram-reposts"

# 9Router API (Chatbot & Visual/Image Processing)
NINEROUTER_BASE_URL="http://127.0.0.1:20128/v1"
NINEROUTER_API_KEY=""
NINEROUTER_MODEL="ag/gemini-3-flash"

# Ollama Local Models (Khusus Embedding - 1024 Dimensi)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="qwen3-embedding:0.6b"

# OpenRouter (Fallback / Opsional)
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="openrouter/free"
OPENROUTER_EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"
OPENROUTER_VISION_MODEL="openrouter/free"

# Autentikasi Single-User (NextAuth)
AUTH_USERNAME="wahyu"
# Password default saat AUTH_PASSWORD_HASH kosong: "admin123" atau "password123"
# Untuk generate hash baru: npx bcryptjs hash "password_anda"
AUTH_PASSWORD_HASH=""
NEXTAUTH_SECRET="repostinsight-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"
