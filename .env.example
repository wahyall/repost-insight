# Database PostgreSQL + pgvector
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repostinsight"

# Apify Actor
APIFY_ACTOR_ID="data-slayer~instagram-reposts"

# OpenRouter (Model gratis)
# Key tunggal untuk fallback (jika tabel openrouter_api_keys di DB kosong).
# Untuk multi-key round-robin, tambahkan baris di tabel `openrouter_api_keys` via dashboard
# atau langsung: INSERT INTO openrouter_api_keys (label, token) VALUES ('key-1', 'sk-or-...');
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="openrouter/free"
OPENROUTER_EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"
OPENROUTER_VISION_MODEL="openrouter/free"

# Autentikasi Single-User (NextAuth)
AUTH_USERNAME="wahyu"
# Password default saat AUTH_PASSWORD_HASH kosong: "admin123" atau "password123"
# Untuk generate hash baru: npx bcryptjs hash "password_anda"
AUTH_PASSWORD_HASH=""
NEXTAUTH_SECRET="repostinsight-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"
